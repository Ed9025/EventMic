<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#2A4A7F" />
            <stroke android:width="3dp" android:color="#4A9EFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1E2A3F" />
            <stroke android:width="2dp" android:color="#4A9EFF" />
        </shape>
    </item>
</selector>
